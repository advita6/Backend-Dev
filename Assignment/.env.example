# Environment Configuration

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/ecommerce
MONGODB_POOL_SIZE=50
MONGODB_MAX_IDLE_TIME=60000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600
REDIS_MAX_RETRIES=10

# Message Queue
QUEUE_NAME=orders
QUEUE_CONCURRENCY=50

# External Services
PAYMENT_GATEWAY_URL=https://api.payment.local
PAYMENT_GATEWAY_TIMEOUT=10000

# Scaling
AUTO_SCALE_ENABLED=true
MIN_DYNOS=1
MAX_DYNOS=500
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=30

# Monitoring
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ecommerce-platform
ALERT_RESPONSE_TIME_THRESHOLD=2000
LOG_LEVEL=debug

# Security
JWT_SECRET=dev-secret-key
SESSION_SECRET=dev-session-secret

# Cost Management
BUDGET_LIMIT=50000
HOURLY_COST_LIMIT=2000

# CORS
CORS_ORIGIN=*
